{
	"$schema": "node_modules/wrangler/config-schema.json",
	// CRM + partner portal: crm.valuefy.ro and portal.valuefy.ro (one Worker, routed by host).
	"name": "crm",
	// worker.ts = the Next.js app (.open-next/worker.js) + the email handler for bank order notices.
	"main": "worker.ts",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Keep the variables set in the Cloudflare dashboard on every deploy.
	"keep_vars": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			// The SAME database as the website (valuefy.ro), so website requests show up in the CRM.
			// database_id: Cloudflare → Storage & Databases → D1 → valuefy-db → copy the ID.
			"binding": "DB",
			"database_name": "valuefy-db",
			"database_id": "588e7204-5b8e-4b2e-9baa-cadbc16841c7",
			// CRM migrations are prefixed 1xxx so they never clash with the website's 0xxx files.
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			// Documents uploaded with orders (extras CF, acte, releveu…). Private: served only through the app.
			"binding": "FILES",
			"bucket_name": "valuefy-documents"
		}
	],
	// Every morning at 06:47 UTC (09:47 / 08:47 in Romania): new SEAP notices for valuations (worker.ts → scheduled).
	// Every hour at :13: the alerts (bell, phone, email) — the ones repeated every few hours go out even when nobody is online.
	"triggers": { "crons": ["47 6 * * *", "13 * * * *"] },
	"observability": { "enabled": true }
}
